# Environment file for compose.prod.yaml. Copy to deploy/prod/<env>.env (ignored
# by Git), fill in the values and pass it with --env-file.

# Compose project and Traefik router prefix; unique per environment on a host.
APP_NAME=people-gator
# Public hostname routed by Traefik; also sets CORS origin and token issuer.
APP_HOST=people-gator.example.org
APP_SCHEME=https
DEPLOY_ENVIRONMENT=production

# Images built once and deployed by tag to every environment.
IMAGE_REGISTRY=ghcr.io/dcgm
IMAGE_TAG=latest
COMMIT_SHA=unknown

# External Traefik. Set TRAEFIK_TLS=false and TRAEFIK_CERTRESOLVER= for an
# HTTP-only entrypoint.
TRAEFIK_NETWORK=web
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_TLS=true
TRAEFIK_CERTRESOLVER=tlschallenge

# Database (stored in the postgres-data volume).
POSTGRES_USER=people_gator
POSTGRES_PASSWORD=change-me
POSTGRES_DB=people_gator

# Users file installed into API storage on every start (Argon2 hashes and scopes).
# Leave empty to keep the users file already in storage.
USERS_FILE=

# Optional S3 storage instead of the api-data volume (single-line JSON).
# API_STORAGE={"local":null,"s3":{"access_key_id":"...","secret_access_key":"...","bucket_name":"...","region":"...","endpoint_url":null}}

# Optional file with extra PEOPLE_GATOR_API__* settings (OpenRouter, OTEL, ...).
# API_ENV_FILE=deploy/prod/production.api.env

API_LOG_LEVEL=info
BACKEND_MEMORY=4g
