# Settings of the shared infrastructure stack. Copy to a private mode-600 file
# outside the checkout, generate the passwords once and keep them: PostgreSQL
# applies POSTGRES_ADMIN_PASSWORD only when its volume is first initialized.
# Hosts upgraded from descriptor-based releases already have this file as
# ~/.local/opt/people-gator-deploy/state/infrastructure/infrastructure.env.
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_openssl_rand_hex_32
PGADMIN_DEFAULT_PASSWORD=REPLACE_WITH_openssl_rand_hex_32
PGADMIN_DEFAULT_EMAIL=admin@peoplegator.dev
PGADMIN_HOST=pgadmin-preview.peoplegator.dev
# Container name the deploy utility addresses (PREVIEW_POSTGRES_CONTAINER).
POSTGRES_CONTAINER=people-gator-postgres
INFRA_ID=preview
DATABASE_NETWORK=people-gator-preview-db
WEB_NETWORK=web
CERTIFICATE_RESOLVER=tlschallenge
