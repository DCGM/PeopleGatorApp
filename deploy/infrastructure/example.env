# Settings of the shared PostgreSQL/pgAdmin stack. Copy to a private mode-600
# file outside the checkout, generate the passwords once and keep them:
# PostgreSQL applies POSTGRES_ADMIN_PASSWORD only when its volume is first
# initialized. Hosts upgraded from descriptor-based releases already have this
# file as ~/.local/opt/people-gator-deploy/state/infrastructure/infrastructure.env.
# The admin URL for PREVIEW_CONFIG / STAGING_CONFIG is then
# postgresql://preview_admin:<POSTGRES_ADMIN_PASSWORD>@people-gator-postgres:5432/postgres
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_openssl_rand_hex_32
PGADMIN_DEFAULT_PASSWORD=REPLACE_WITH_openssl_rand_hex_32
PGADMIN_DEFAULT_EMAIL=admin@peoplegator.dev
PGADMIN_HOST=pgadmin-preview.peoplegator.dev
