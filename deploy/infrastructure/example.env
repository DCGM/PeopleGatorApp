# Private settings of the shared infrastructure stack. Copy to a mode-600 file
# outside the checkout and keep it: PostgreSQL applies the password only when its
# volume is first initialized.
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_32
POSTGRES_USER=postgres
# Host port Traefik serves HTTPS on (there is no HTTP port).
HTTPS_PORT=443
# Your copy of traefik.example.yaml.
TRAEFIK_CONFIG=/private/traefik.yaml
# Rootless Docker socket for Traefik, for example /run/user/1001/docker.sock.
DOCKER_SOCKET=/var/run/docker.sock
