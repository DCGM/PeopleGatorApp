# Private settings of the shared infrastructure stack. Copy to a mode-600 file
# outside the checkout and keep it: PostgreSQL applies the password only when its
# volume is first initialized.
# Generate the password once with:   openssl rand -hex 32
# (64 hex characters, safe in database URLs without escaping). Use the same value
# in PREVIEW_DATABASE_URL / STAGING_DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_32
POSTGRES_USER=postgres
# Host port Traefik serves HTTPS on (there is no HTTP port).
HTTPS_PORT=443
# Your copy of traefik.example.yaml.
TRAEFIK_CONFIG=/private/traefik.yaml
# Traefik dashboard: host name and its basic-auth users file (user:hash lines,
# for example: printf 'admin:%s\n' "$(openssl passwd -apr1 '<password>')").
TRAEFIK_DASHBOARD_HOST=traefik-preview.peoplegator.dev
TRAEFIK_DASHBOARD_USERS=./dashboard.users
# Rootless Docker socket for Traefik, for example /run/user/1001/docker.sock.
DOCKER_SOCKET=/var/run/docker.sock
# Optional pgAdmin (https://<PGADMIN_HOST>, behind the dashboard login, then
# PGADMIN_EMAIL / PGADMIN_PASSWORD). Enable with COMPOSE_PROFILES=pgadmin.
# COMPOSE_PROFILES=pgadmin
PGADMIN_HOST=pgadmin-preview.peoplegator.dev
PGADMIN_EMAIL=admin@peoplegator.dev
PGADMIN_PASSWORD=REPLACE_WITH_openssl_rand_hex_16
