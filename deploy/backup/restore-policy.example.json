{
  "Version": "2012-10-17",
  "Statement": [
    {"Effect": "Allow", "Action": ["s3:ListBucket"], "Resource": "arn:aws:s3:::peoplegator-db-backup", "Condition": {"StringLike": {"s3:prefix": ["production/db-backups/*"]}}},
    {"Effect": "Allow", "Action": ["s3:GetObject", "s3:GetObjectVersion"], "Resource": "arn:aws:s3:::peoplegator-db-backup/production/db-backups/*"}
  ]
}
